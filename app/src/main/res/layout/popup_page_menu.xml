<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/menu_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:id="@+id/textRead"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_read"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textLoadAndRead"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_load_and_read"
            android:textSize="16sp" />

        <View
            android:id="@+id/textReadBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/menu_border" />

        <TextView
            android:id="@+id/textOpen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_open"
            android:textSize="16sp" />

        <View
            android:id="@+id/textOpenBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/menu_border" />

        <TextView
            android:id="@+id/textOpenNewWindow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_open_new_window"
            android:textSize="16sp" />

        <View
            android:id="@+id/textOpenNewWindowBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/menu_border" />

        <TextView
            android:id="@+id/textOpenChrome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_open_chrome"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/menu_border" />

        <TextView
            android:id="@+id/textSelectText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="@string/popup_menu_select_text"
            android:textSize="16sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>